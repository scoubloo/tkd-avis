# Modèle de configuration — copier en .env (jamais commité).
# En production, le fichier réel vit dans INFRA/.secrets/tkd-avis.env sur le Mac,
# et dans /docker/tkd-avis/.env sur le VPS (chmod 600).

# --- Base de données ---------------------------------------------------------
DATABASE_URL=postgres://tkd:motdepasse@localhost:5433/tkd_avis

# --- Adresse publique --------------------------------------------------------
# Sert à construire les liens de confirmation envoyés par e-mail.
# Doit inclure le sous-chemin.
PUBLIC_URL=http://localhost:3210/tkd-avis
BASE_PATH=/tkd-avis

# --- Envoi d'e-mails (SMTP Gmail, mot de passe applicatif) -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=exemple@gmail.com
SMTP_PASSWORD=motdepasseapplicatif
SMTP_FROM="Avis TKD <exemple@gmail.com>"

# --- Environnement -----------------------------------------------------------
NODE_ENV=development
